{
  "name": "idealab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IdeaLab - a local-first high-volume idea discovery laboratory driven by local models (Ollama).",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/bootstrap.mjs",
    "serve": "node server/src/index.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/scoring.test.js tests/jsonStream.test.js tests/similarity.test.js tests/knowledge.test.js tests/ui.test.js",
    "test:pipeline": "node --test tests/pipeline.test.js",
    "test:api": "node --test tests/api.test.js",
    "ollama:check": "node scripts/ollama-check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
